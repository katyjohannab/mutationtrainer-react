# Required for writable admin login
WM_ADMIN_PASSWORD=change-me

# Optional runtime knobs (public hosting needs persistent data AND revision storage)
# WM_DATA_DIR=/var/lib/mutationtrainer/data
# WM_REVISION_DIR=/var/lib/mutationtrainer/revisions
PORT=4173
WM_BIND_HOST=0.0.0.0
WM_ADMIN_SESSION_TTL_HOURS=12
WM_BASE_PATH=/mutationtrainer-react/

# Optional (used by reverse proxy assumptions)
NODE_ENV=production
